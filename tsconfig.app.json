{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase"
  ]
}
